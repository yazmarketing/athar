# BytePlus ModelArk — PRIMARY provider. SERVER ONLY.
ARK_API_KEY=your-byteplus-modelark-key
# Optional: ModelArk chat model for Prompt editor “AI improve”
# Use a chat inference endpoint / model slug you have access to.
# ARK_CHAT_MODEL=seed-1-6-250915

# BytePlus Assets API (private portrait library — real/AI faces in video).
# Access key pair from BytePlus console → API keys → Access key (AK/SK).
# SERVER ONLY. Optional until you register face/character assets.
# BYTEPLUS_ACCESS_KEY=your-byteplus-access-key
# BYTEPLUS_SECRET_KEY=your-byteplus-secret-key
# BYTEPLUS_ASSETS_REGION=ap-southeast-1

# Google Gemini image models — "Nano Banana" (gemini-2.5-flash-image),
# "Nano Banana 2" (gemini-3.1-flash-image) and "Nano Banana Pro"
# (Gemini 3 Pro Image). One key serves all three. SERVER ONLY.
# Without it they sit in the model picker and fail at generate time.
# Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Optional model-id overrides — Google renames these when a preview goes GA.
# Defaults live in src/config/models.ts (GOOGLE_IMAGE_MODELS).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_NANO2_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_PRO_IMAGE_MODEL=gemini-3-pro-image-preview

# OpenAI GPT Image 2 — still generation/edits via /v1/images.
# Uses the same OPENAI_API_KEY as chat and Whisper. Without it the model
# sits in the picker and fails at generate time.
# Optional model-id override (default gpt-image-2).
# OPENAI_IMAGE_MODEL=gpt-image-2

# DigitalOcean Managed Postgres — connection string from the DO control
# panel (Databases → Connection Details). SERVER ONLY.
DATABASE_URL=postgresql://doadmin:password@your-db-do-user.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# DigitalOcean Spaces (S3-compatible object storage). SERVER ONLY.
# Keys: API → Spaces Keys. Region/bucket: from your Space's settings.
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
# Optional: Spaces CDN endpoint for faster public delivery
# DO_SPACES_CDN_URL=https://your-bucket-name.fra1.cdn.digitaloceanspaces.com

# Auth — internal studio gate (required in EVERY environment, incl. local dev)
# Generate secret: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# NextAuth v4 signs session JWTs with NEXTAUTH_SECRET — keep it identical to
# AUTH_SECRET or sign-in will succeed and then every request will bounce.
NEXTAUTH_SECRET=replace-with-the-same-value-as-AUTH_SECRET
AUTH_INTERNAL_PASSWORD=replace-with-shared-internal-password
# REQUIRED. At least one of these must be set or NOBODY can sign in: the
# allowlist fails closed, so an empty allowlist locks the studio rather than
# opening it. Comma-separated; use either or both.
AUTH_ALLOWED_DOMAINS=yazmedia.com
AUTH_ALLOWED_EMAILS=you@yazmedia.com
# First admin on sign-in (optional)
# AUTH_ADMIN_EMAIL=you@yazmedia.com

# Optional Google OAuth (Workspace)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Transcription ---------------------------------------------------------
# OpenAI's hosted Whisper — github.com/openai/whisper, run by OpenAI. Uses the
# `whisper-1` model specifically: it is the only one of theirs that returns
# word-level timestamps, which is the point of the feature.
#
# $0.006/min of audio ($0.36/hr), billed to the second, nothing when idle.
# The same key already serves prompt-improve, summaries and Ask.
#
# The browser strips the audio out of a video before anything is sent, so a
# 500MB export becomes a few MB and stays inside OpenAI's 25MB per-request cap.
OPENAI_API_KEY=

PUBLIC_APP_URL=http://localhost:3000

# Summaries, clip picks, transcript Q&A and subtitle translation use whichever
# chat model is configured — OPENAI_API_KEY first, ARK_CHAT_MODEL as fallback.
# Transcription itself uses neither.
# OPENAI_API_KEY=

# --- Text-to-Speech (Munsit) ------------------------------------------------
# Arabic-first TTS API — https://docs.munsit.com. Powers the Voice page.
# Get a key: https://app.munsit.com/en/api-keys
MUNSIT_API_KEY=
# MUNSIT_BASE_URL=https://api.munsit.com/api/v1
# MUNSIT_MODEL_ID=faseeh-v1-preview
# There's no billing API to read real spend from, so this is an estimate:
# Faseeh TTS is 2 credits/character. Defaults to $0.0001/char (the Pro plan's
# $10/200,000-credit rate). Override if the account is on a different plan —
# Team ($100/3M credits) is ~$0.0000667, Growth ($250/10M) is $0.00005,
# Scale ($800/50M) is $0.000032.
# MUNSIT_COST_PER_CHAR=0.0001
